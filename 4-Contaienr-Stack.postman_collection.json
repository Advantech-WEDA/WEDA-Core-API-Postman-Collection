              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Device stacks deployed structure is correct (Manual Every)\", function () {",
                  "    var responseData = pm.response.json();",
                  "    var jsonData = responseData.items;",
                  "    var expectedDeviceId = pm.collectionVariables.get('deviceId');",
                  "    pm.expect(jsonData, 'Response must be a non-empty array').to.be.an('array').and.to.not.be.empty;",
                  "    pm.expect(jsonData, 'All items must contain stackRevisionId').to.satisfy(arr => {",
                  "        return arr.every(item => item.stackRevisionId !== undefined && item.stackRevisionId !== null);",
                  "    });",
                  "    pm.expect(jsonData, 'All items must contain deploymentId').to.satisfy(arr => {",
                  "        return arr.every(item => item.deploymentId !== undefined && item.deploymentId !== null);",
                  "    });",
                  "    pm.expect(jsonData, 'All items must contain deviceId').to.satisfy(arr => {",
                  "        return arr.every(item => item.deviceId !== undefined && item.deviceId !== null);",
                  "    });",
                  "    jsonData.forEach(function(item) {",
                  "        pm.expect(item.deviceId, 'Each deployed stack must match the expected deviceId').to.eql(expectedDeviceId);",
                  "    });",
                  "    pm.collectionVariables.set('deploymentId', jsonData[0].deploymentId);",
