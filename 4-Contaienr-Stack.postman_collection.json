    {
      "name": "Stack Mgmt & Deployment",
      "item": [
        {
          "name": "Check Stack Name Availability in Org",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Stack name is available\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalCount');",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    ",
                  "    // Stack name is available if no items are returned",
                  "    if (jsonData.totalCount === 0 || jsonData.items.length === 0) {",
                  "        console.log('Stack name \"integration-test-stack\" is available');",
                  "        pm.collectionVariables.set('stackNameAvailable', 'true');",
                  "    } else {",
                  "        console.log('Stack name \"integration-test-stack\" already exists');",
                  "        pm.collectionVariables.set('stackNameAvailable', 'false');",
                  "        ",
                  "        // Show existing stack details",
                  "        var existingStack = jsonData.items[0];",
                  "        console.log('Existing stack ID: ' + existingStack.id);",
                  "        console.log('Existing stack revision: ' + existingStack.stackRevisionId);",
                  "        ",
                  "        // Generate a unique stack name for this test run",
                  "        var timestamp = new Date().getTime();",
                  "        var newStackName = 'integration-test-stack-' + timestamp;",
                  "        pm.collectionVariables.set('uniqueStackName', newStackName);",
                  "        console.log('Generated unique stack name: ' + newStackName);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Response has correct structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalCount');",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apibaseurl}}/orgs/{{org_id}}/stack-configs?stackName={{finalStackName}}&maxResultCount=1",
              "host": [
                "{{apibaseurl}}"
              ],
              "path": [
                "orgs",
                "{{org_id}}",
                "stack-configs"
              ],
              "query": [
                {
                  "key": "stackName",
                  "value": "{{finalStackName}}"
                },
                {
                  "key": "maxResultCount",
                  "value": "1"
                }
              ]
            },
            "description": "Checks if the stack name 'integration-test-stack' is already in use. If it exists, generates a unique name with timestamp."
          },
          "response": []
        },
        {
          "name": "Create Stack",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set the stack name to use based on availability check",
                  "var uniqueStackName = pm.collectionVariables.get('uniqueStackName');",
                  "var finalStackName = uniqueStackName || 'integration-test-stack';",
                  "pm.collectionVariables.set('finalStackName', finalStackName);",
                  "console.log('Using stack name: ' + finalStackName);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has stackRevisionId and stackConfigId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('stackRevisionId');",
                  "    pm.expect(jsonData).to.have.property('stackConfigId');",
                  "    pm.collectionVariables.set('stackRevisionId', jsonData.stackRevisionId);",
                  "    pm.collectionVariables.set('stackConfigId', jsonData.stackConfigId);",
                  "});",
                  "",
                  "pm.test(\"Stack name matches request\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedStackName = pm.collectionVariables.get('finalStackName');",
                  "    pm.expect(jsonData.stackName).to.eql(expectedStackName);",
                  "});",
                  "",
                  "pm.test(\"Stack has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('type');",
                  "    pm.expect(jsonData).to.have.property('composeFileContent');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stackName\": \"{{finalStackName}}\",\n  \"type\": \"compose\",\n  \"composeFileContent\": \"dmVyc2lvbjogIjMuOCIKc2VydmljZXM6CiAgbmdpbng6CiAgICBpbWFnZTogbmdpbng6bGF0ZXN0CiAgICBwb3J0czoKICAgICAgLSAiODA6ODAiCiAgICB2b2x1bWVzOgogICAgICAtIC4vaHR0bWw6L3Vzci9zaGFyZS9uZ2lueC9odG1s\",\n  \"environment\": {},\n  \"description\": \"Integration test stack for Postman collection\"\n}"
            },
