{
	"info": {
		"_postman_id": "12966437-2325-4555-8805-0996b30fcee5",
		"name": "1-Org&ClientCred",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "40706131"
	},
	"item": [
		{
			"name": "Orgs",
			"item": [
				{
					"name": "Org List(Get organizations)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', () => pm.expect(pm.response.code).to.eql(200));",
									"const responseJson = pm.response.json();",
									"const orgs = responseJson.items;",
									"const login = pm.environment.get('login');",
									"const org = orgs.find(o => o.name === login);",
									"if (org) {",
									"    pm.environment.set('org_id', org.orgId);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{apibaseurl}}/orgs?skipCount=0&maxResultCount=100",
							"host": [
								"{{apibaseurl}}"
							],
							"path": [
								"orgs"
							],
							"query": [
								{
									"key": "skipCount",
									"value": "0"
								},
								{
									"key": "maxResultCount",
									"value": "100"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Org Create(Create a new organization)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 201', () => pm.expect(pm.response.code).to.eql(201));",
									"const responseJson = pm.response.json();",
									"pm.environment.set('org_id', responseJson.orgId);",
									"pm.environment.set('org_name', responseJson.name);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{login}}\",\n  \"description\": \"This is a sample '{{login}}' Root Organization.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apibaseurl}}/orgs",
							"host": [
								"{{apibaseurl}}"
							],
							"path": [
								"orgs"
							]
						}
					},
					"response": []
				},
				{
					"name": "Org Delete(Delete an organization)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 204', () => pm.expect(pm.response.code).to.eql(204));",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{apibaseurl}}/orgs/{{org_id}}?orgName={{org_name}}",
							"host": [
								"{{apibaseurl}}"
							],
							"path": [
								"orgs",
								"{{org_id}}"
							],
							"query": [
								{
									"key": "orgName",
									"value": "{{org_name}}"
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
